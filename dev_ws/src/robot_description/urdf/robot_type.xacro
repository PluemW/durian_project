<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="wheel" params="number pos_x pos_y pos_z">
  
    <!-- Joint -->
    <joint name="wheel_${number}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${number}_link"/>
      <axis xyz="0 0 1"/>
      <origin xyz="${pos_x} ${pos_y} ${pos_z}" rpy="-1.57 0 0"/>
      <limit effort="100.0" velocity="20.0" lower="-3.14" upper="3.14"/>
    </joint>

    <!-- Link -->
    <link name="wheel_${number}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.1"/>
        </geometry>
        <material name="Blue">
          <color rgba="0.0 0.0 1.0 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.1"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      </inertial>
    </link>
  </xacro:macro>

</robot>
