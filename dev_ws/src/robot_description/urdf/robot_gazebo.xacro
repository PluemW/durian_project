<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <gazebo>
    
    <!-- Publish the ground-truth pose for rviz -->
    <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <dimensions>3</dimensions>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_1_joint</joint_name>
      <use_force_commands>true</use_force_commands>
      <topic>/wheel_1_joint/command</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_2_joint</joint_name>
      <use_force_commands>true</use_force_commands>
      <topic>/wheel_2_joint/command</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_3_joint</joint_name>
      <use_force_commands>true</use_force_commands>
      <topic>/wheel_3_joint/command</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_4_joint</joint_name>
      <use_force_commands>true</use_force_commands>
      <topic>/wheel_4_joint/command</topic>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>wheel_1_joint</joint_name>
      <joint_name>wheel_2_joint</joint_name>
      <joint_name>wheel_3_joint</joint_name>
      <joint_name>wheel_4_joint</joint_name>
    </plugin>
  </gazebo>
</robot>