<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <!-- Include xacro -->
    <xacro:include filename="$(find robot_description)/urdf/robot_steering.xacro"/>
    <xacro:include filename="$(find robot_description)/urdf/robot_type.xacro"/>

    <!-- Base structure -->
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="1 1 0.3"/> <!-- z: -0.15 -->
        </geometry>
        <material name="Orange">
          <color rgba="1.0 0.5 0 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="1 1 0.3"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="5.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0"
                 iyy="0.1" iyz="0.0"
                 izz="0.1"/>
      </inertial>
    </link>

    <!-- Wheel -->
    <xacro:wheel prefix="steering_1_link" number="1" pos_x="0" pos_y="0.075" pos_z="-0.075"/>
    <xacro:wheel prefix="steering_2_link" number="2" pos_x="0" pos_y="0.075" pos_z="-0.075"/>
    <xacro:wheel prefix="steering_3_link" number="3" pos_x="0" pos_y="-0.075" pos_z="-0.075"/>
    <xacro:wheel prefix="steering_4_link" number="4" pos_x="0" pos_y="-0.075" pos_z="-0.075"/>

</robot>